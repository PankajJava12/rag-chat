{
  "name": "ai-advisor-assistant",
  "version": "0.7.0",
  "private": true,
  "description": "Local tenant-aware insurance ingestion and grounded policy chat",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n api,worker,web \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:api": "node --env-file=.env.development --import tsx --watch apps/api/src/server.ts",
    "dev:worker": "node --env-file=.env.development --import tsx --watch apps/worker/src/worker.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "jest --runInBand",
    "test:integration": "node --env-file=.env.test node_modules/jest/bin/jest.js --config jest.integration.config.cjs --runInBand",
    "db:migrate": "node --env-file=.env.development --import tsx packages/database/src/migrate.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "format": "prettier --write apps packages tests scripts docs *.json *.cjs *.mjs *.yml .github/workflows/*.yml README.md",
    "db:seed": "node --env-file=.env.development --import tsx packages/database/src/seed.ts",
    "test:e2e": "node --env-file=.env.development --import tsx tests/e2e/ingestion.ts",
    "docs:api": "node scripts/openapi.mjs",
    "test:chat": "node --env-file=.env.development --import tsx tests/e2e/chat.ts",
    "db:keywords": "node --env-file=.env.development --import tsx scripts/backfill-keywords.ts",
    "test:security": "node --env-file=.env.development scripts/security-smoke.mjs",
    "test:localstack": "node --env-file=.env.development --import tsx tests/e2e/localstack.ts",
    "localstack:up": "docker compose --env-file .env.development -f docker-compose.yml -f docker-compose.localstack.yml up -d --build --wait",
    "test:advanced": "node --env-file=.env.development --import tsx tests/e2e/advanced.ts",
    "test:localstack:containers": "node --env-file=.env.development scripts/localstack-smoke.mjs",
    "host:start": "node scripts/host.mjs start",
    "host:stop": "node scripts/host.mjs stop",
    "host:status": "node scripts/host.mjs status",
    "observability:up": "docker compose -f docker-compose.observability.yml up -d",
    "test:performance": "node --env-file=.env.host scripts/performance.mjs",
    "host:prepare": "node --env-file=.env.development scripts/host-prepare.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/client-sqs": "3.1147.0",
    "@langchain/langgraph": "1.4.21",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-node": "0.223.0",
    "@prometheus-io/client": "0.16.1",
    "aws-jwt-verify": "5.2.1",
    "cheerio": "1.2.0",
    "csv-parse": "7.0.3",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "js-tiktoken": "1.0.21",
    "jsonwebtoken": "9.0.3",
    "mammoth": "1.13.0",
    "openai": "7.30.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "yauzl": "3.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.1",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.5",
    "docx": "9.9.0",
    "eslint": "10.12.0",
    "jest": "30.5.2",
    "pdfkit": "0.20.2",
    "prettier": "3.9.9",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "overrides": {
    "shell-quote": "1.12.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
