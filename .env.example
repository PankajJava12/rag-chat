# Run npm run setup; generated .env.development/.env.test are ignored and mode 0600.
NODE_ENV=development
API_PORT=3000
WORKER_PORT=3001
DATABASE_URL=postgresql://advisor_app:REPLACE@localhost:5432/advisor
WORKER_DATABASE_URL=postgresql://advisor_worker:REPLACE@localhost:5432/advisor
MIGRATION_DATABASE_URL=postgresql://advisor_owner:REPLACE@localhost:5432/advisor
REDIS_URL=redis://localhost:6379
AUTH_MODE=local
AUTH_SECRET=GENERATE_WITH_SETUP
STORAGE_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_WITH_SETUP
LOCAL_TENANT_ID=GENERATE_WITH_SETUP
LOCAL_ADMIN_EMAIL=admin@advisor.local
LOCAL_ADMIN_PASSWORD=GENERATE_WITH_SETUP
LOCAL_ADVISOR_EMAIL=advisor@advisor.local
LOCAL_ADVISOR_PASSWORD=GENERATE_WITH_SETUP
WORKER_DB_PASSWORD=GENERATE_WITH_SETUP
STORAGE_DIRECTORY=.local/documents
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text:v1.5
EMBEDDING_BATCH_SIZE=8
# Ollama/Gemini = 768 dimensions; OpenAI profile = 1536. Checked against schema.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
AWS_REGION=ap-south-1
LOG_LEVEL=info
# Optional future/cloud-boundary adapter configuration; unused in default local Compose:
OPENAI_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Phase 3: local generation; OpenAI is explicitly opt-in.
CHAT_PROVIDER=ollama
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
CHAT_TIMEOUT_MS=180000
CHAT_CONTEXT_TOKENS=2000
# Use 2048 for longer Gemini responses; valid range is 128–4096.
CHAT_MAX_OUTPUT_TOKENS=768
CHAT_TOP_K=8

# Phase 4: hybrid candidate fusion and optional local heuristic reranking
RETRIEVAL_MODE=hybrid
RETRIEVAL_RERANK=true
RETRIEVAL_CANDIDATES=20

# Phase 5: keep policy/customer text local; remote endpoints require approved opt-in.
ALLOW_EXTERNAL_AI=false

# Phase 6: default local filesystem + PostgreSQL queue, no AWS calls.
DEPLOYMENT_TARGET=local
STORAGE_PROVIDER=local
QUEUE_PROVIDER=postgres
PRODUCTION_DEPLOYMENT_APPROVED=false
# LocalStack overlay supplies the following; host test uses localhost:4566.
# AWS_ENDPOINT_URL=http://localstack:4566
# S3_BUCKET=advisor-policies-local
# SQS_QUEUE_URL=http://localstack:4566/000000000000/advisor-ingestion
# S3_KMS_KEY_ID=
# Optional separate private Ollama generation endpoint for future deployment.
# OLLAMA_CHAT_URL=

# Phase 7 native host: generated .env.host overrides these locally.
BIND_HOST=127.0.0.1
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=300
METRICS_ENABLED=false
# Native default is loopback; Docker overlay explicitly selects 0.0.0.0 on its private network.
# METRICS_BIND_HOST=127.0.0.1
TRACING_ENABLED=false
# Host launcher supplies role-specific metrics port and OTEL_SERVICE_NAME.
# METRICS_PORT=9464
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Optional approved external API prices; unset/zero = pricing unconfigured.
# EMBEDDING_INPUT_USD_PER_MILLION=
# GENERATION_INPUT_USD_PER_MILLION=
# GENERATION_OUTPUT_USD_PER_MILLION=

# Gemini chat and new-document embeddings (host runtime):
# Set CHAT_PROVIDER=gemini, EMBEDDING_PROVIDER=gemini, ALLOW_EXTERNAL_AI=true.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
