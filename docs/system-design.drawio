        <mxCell id="conv" value="conversations&#10;Owner + policy + optional comparison&#10;As-of date / explicit version IDs&#10;Expiry + encrypted question memory" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
