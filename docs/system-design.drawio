        <mxCell id="versions" value="document_versions&#10;Immutable original / hash / size&#10;Effective interval + supersedes_id&#10;Scan + indexing status&#10;active_generation_id" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="160" width="310" height="160" />
