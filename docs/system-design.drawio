          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="foot" value="Comparison mode executes one scoped workflow per policy sequentially, then combines verified quotes with renumbered citations. Scores are ranking signals, not confidence probabilities." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
