  <diagram id="p2" name="2 - Document ingestion">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1350" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Document ingestion — asynchronous, versioned, generation-based" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1450" height="45" />
        </mxCell>
        <mxCell id="sub" value="Solid arrows show successful flow; dashed arrows show optional notification and retry paths. Upload URL is an API route, not a direct S3 presigned URL." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="1450" height="60" />
        </mxCell>
        <mxCell id="reserve" value="1. Reserve upload&#10;POST /documents/upload-url&#10;Admin + idempotency + metadata&#10;Create PENDING_UPLOAD version" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="280" height="140" />
        </mxCell>
        <mxCell id="put" value="2. Upload bytes&#10;PUT /documents/uploads/:versionId&#10;Owner / expiry / length / MIME&#10;SHA-256 + byte validation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="170" width="280" height="140" />
        </mxCell>
        <mxCell id="store" value="3. Encrypt original&#10;AES-256-GCM + object context&#10;Immutable local/S3 storage&#10;Record uploaded_at" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="170" width="280" height="140" />
        </mxCell>
        <mxCell id="complete" value="4. Complete upload&#10;POST /documents/complete-upload&#10;Create job + new generation&#10;Version → UPLOADED; HTTP 202" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="170" width="280" height="140" />
        </mxCell>
        <mxCell id="claim" value="5. Worker claims DB job&#10;FOR UPDATE SKIP LOCKED&#10;90-second lease + random token&#10;Heartbeat every 20 seconds" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="410" width="280" height="140" />
        </mxCell>
        <mxCell id="verify" value="6. Read / decrypt / verify&#10;Repeat hash + size checks&#10;ClamAV scan + byte validation&#10;Version → PROCESSING / CLEAN" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="410" width="280" height="140" />
        </mxCell>
        <mxCell id="parse" value="7. Isolated parsing&#10;256 MiB worker-thread heap limit&#10;Five-minute parse timeout&#10;Format-specific source metadata" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="410" width="280" height="140" />
        </mxCell>
        <mxCell id="format" value="PDF: pdftotext -layout per page&#10;&lt;30 extracted characters → OCR&#10;DOCX: headings + table rows&#10;XLSX/CSV: header-labelled rows" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="410" width="280" height="140" />
        </mxCell>
        <mxCell id="chunk" value="8. Normalize and chunk&#10;cl100k_base token accounting&#10;650-token size / 90 overlap&#10;Paragraph packing; table row intact" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="680" width="280" height="140" />
        </mxCell>
        <mxCell id="cache" value="9. Deduplicate embedding work&#10;SHA-256 of chunk text&#10;Postgres cache scoped by tenant&#10;+ model + dimensions" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="680" width="280" height="140" />
        </mxCell>
        <mxCell id="embed" value="10. Embed only cache misses&#10;Default batch: 8; max: 32&#10;OpenAI 1536 / Gemini 768&#10;Ollama 768; validate vectors" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="680" width="280" height="140" />
        </mxCell>
        <mxCell id="write" value="11. Persist generation batches&#10;Encrypted text + source metadata&#10;Vector + tenant-keyed tsvector&#10;Fenced lease checked before writes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1080" y="940" width="280" height="140" />
        </mxCell>
        <mxCell id="publish" value="12. Atomic generation activation&#10;Verify exact expected chunk count&#10;Set active_generation_id + INDEXED&#10;Job COMPLETED + audit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="740" y="940" width="280" height="140" />
        </mxCell>
        <mxCell id="ready" value="Searchable active generation&#10;Queries exclude partial generations&#10;Old generation remains during reindex&#10;Applicable version rules still apply" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="940" width="280" height="140" />
        </mxCell>
        <mxCell id="retry" value="Failure / crash recovery&#10;Retryable jobs: exponential delay + jitter&#10;Maximum 3 job attempts&#10;Expired lease can be reclaimed&#10;Terminal FAILED; fenced stale worker" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="940" width="280" height="140" />
        </mxCell>
        <mxCell id="e19" value="" source="reserve" target="put" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e20" value="" source="put" target="store" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e21" value="" source="store" target="complete" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e22" value="" source="complete" target="claim" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e23" value="" source="claim" target="verify" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e24" value="" source="verify" target="parse" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e25" value="" source="parse" target="chunk" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e26" value="" source="chunk" target="cache" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e27" value="" source="cache" target="embed" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e28" value="" source="embed" target="write" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
