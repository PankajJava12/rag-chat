  <diagram id="p1" name="1 - System overview">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="AI Advisor Assistant — implemented system architecture" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1450" height="45" />
        </mxCell>
        <mxCell id="sub" value="API and worker are separate processes. PostgreSQL is the durable authority. Cloud/provider boxes are configurable alternatives, not simultaneous requirements." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="1450" height="55" />
        </mxCell>
        <mxCell id="web" value="React / Vite frontend&#10;DocumentLibrary + AdvisorChat" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="280" height="100" />
        </mxCell>
        <mxCell id="api" value="Express API&#10;Authentication / RBAC / origins&#10;Upload, search, chat, sources" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="170" width="300" height="115" />
        </mxCell>
        <mxCell id="auth" value="Local JWT + scrypt&#10;or Cognito access-token verification&#10;Server-side membership checks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="360" width="280" height="110" />
        </mxCell>
        <mxCell id="chat" value="ChatService + LangGraph&#10;Rewrite → retrieve → generate&#10;Validate → persist → deliver" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="170" width="310" height="115" />
        </mxCell>
        <mxCell id="db" value="PostgreSQL + pgvector + RLS&#10;Policies / versions / active chunks&#10;Jobs + notification outbox&#10;Embedding cache / chat / audit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;shape=cylinder;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="440" width="330" height="165" />
        </mxCell>
        <mxCell id="redis" value="Redis&#10;Encrypted query-embedding cache&#10;Tenant + model + dimensions + query&#10;Default TTL: 300 seconds" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;shape=cylinder;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="440" width="310" height="120" />
        </mxCell>
        <mxCell id="storage" value="Encrypted original files&#10;Local filesystem OR S3&#10;LocalStack: encrypted local mirror&#10;S3 server-side encryption too" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;shape=cylinder;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="660" width="290" height="130" />
        </mxCell>
        <mxCell id="sqs" value="Optional SQS notifications&#10;Job hints only; DB owns leases&#10;DB ingestion_notifications dispatch" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="730" width="330" height="105" />
        </mxCell>
        <mxCell id="worker" value="Ingestion worker&#10;Claim PostgreSQL job + fenced lease&#10;Scan → parse/OCR → chunk → embed&#10;Activate complete generation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="890" y="730" width="310" height="130" />
        </mxCell>
        <mxCell id="scan" value="ClamAV + parser worker thread&#10;Poppler / Tesseract / Mammoth&#10;ExcelJS / csv-parse" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1260" y="730" width="280" height="130" />
        </mxCell>
