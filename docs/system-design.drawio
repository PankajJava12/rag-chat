  <diagram id="p3" name="3 - Query and answer pipeline">
    <mxGraphModel dx="1600" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Query pipeline — scoped hybrid retrieval and verified quotations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="20" width="1450" height="45" />
        </mxCell>
        <mxCell id="sub" value="LangGraph runs rewriting → retrieving → generating → validating. ChatService owns request reservation, scope, persistence and final authorization/version checks." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="70" width="1580" height="60" />
        </mxCell>
        <mxCell id="request" value="1. POST conversation message&#10;Question + Idempotency-Key&#10;Authentication + ownership + rate limit&#10;Abort on disconnect / timeout" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="300" height="160" />
        </mxCell>
        <mxCell id="reserve" value="2. Reserve chat_runs&#10;Question fingerprint + request key&#10;Replay completed same-key request&#10;One active run per conversation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="170" width="300" height="160" />
        </mxCell>
        <mxCell id="memory" value="3. Rewrite follow-up&#10;Deterministic rules, not an LLM&#10;Encrypted bounded question memory&#10;Assistant answers never evidence" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="170" width="300" height="160" />
        </mxCell>
        <mxCell id="scope" value="4. Resolve applicable versions&#10;Tenant + policy + as-of date / IDs&#10;Effective dates + supersession&#10;Require CLEAN + active generation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="170" width="300" height="160" />
        </mxCell>
        <mxCell id="embed" value="5a. Semantic branch&#10;Compatible model profile only&#10;Query embedding via Redis cache&#10;pgvector cosine distance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="410" width="300" height="160" />
        </mxCell>
        <mxCell id="keyword" value="5b. Keyword branch&#10;Normalize + HMAC tenant lexemes&#10;OR tsquery / ts_rank_cd / GIN&#10;Includes older embedding profiles" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="410" width="300" height="160" />
        </mxCell>
        <mxCell id="fusion" value="6. Fuse and rerank&#10;RRF: sum 1 / (60 + rank)&#10;Decrypt candidate text / metadata&#10;Lexical + cosine + heading reranker&#10;Default 20 candidates/branch → top 8" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="410" width="300" height="160" />
        </mxCell>
        <mxCell id="context" value="7. Build evidence context&#10;Recover PDF columns / paragraphs&#10;Rerank excerpts + deduplicate&#10;Filter suspicious instructions&#10;Default budget: 2000 tokens" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="410" width="300" height="160" />
        </mxCell>
        <mxCell id="guard" value="8. Evidence / topic guards&#10;No evidence → abstain&#10;Suspicious question → abstain&#10;Matching complete table may bypass LLM" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="720" width="300" height="160" />
        </mxCell>
        <mxCell id="generate" value="9. Structured generation&#10;Question + S1/S2 evidence only&#10;JSON: status + sourceId + quote&#10;ANSWER / INSUFFICIENT / CONFLICT&#10;Max four citations" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="720" width="300" height="160" />
        </mxCell>
        <mxCell id="validate" value="10. Validate quotations&#10;Known source ID + contiguous quote&#10;Whole sentences / paragraphs&#10;Complete table; topic check&#10;Invalid draft → abstention" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="720" width="300" height="160" />
        </mxCell>
        <mxCell id="conflict" value="Narrow deterministic conflict rule&#10;Same waiting-period clause&#10;Different integer values / same units&#10;Otherwise model proposes conflict" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="720" width="300" height="160" />
        </mxCell>
        <mxCell id="recheck" value="11. Reauthorize + recheck sources&#10;Version set + active generations&#10;All evidence chunks checked&#10;Concurrent changes → retry error" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="1010" width="300" height="160" />
        </mxCell>
        <mxCell id="persist" value="12. Atomic persistence&#10;Encrypted question + answer&#10;Encrypted run response for replay&#10;Update question memory + audit" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="440" y="1010" width="300" height="160" />
        </mxCell>
        <mxCell id="deliver" value="13. Deliver validated answer&#10;SSE status + heartbeat during work&#10;Validated paragraphs after commit&#10;Citation links to original version" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1010" width="300" height="160" />
        </mxCell>
        <mxCell id="e19" value="" source="request" target="reserve" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e20" value="" source="reserve" target="memory" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
