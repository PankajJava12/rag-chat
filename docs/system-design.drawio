          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e28" value="" source="guard" target="generate" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e29" value="" source="generate" target="validate" parent="1" edge="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;">
          <mxGeometry as="geometry" relative="1" />
