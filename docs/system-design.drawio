        <mxCell id="jobs" value="ingestion_jobs&#10;Version + generation&#10;Attempt / lease token / lease expiry&#10;Progress + input-token usage" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="430" width="280" height="140" />
        </mxCell>
        <mxCell id="notify" value="ingestion_notifications&#10;Job ID / publish lease / retries&#10;Durable SQS notification outbox" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
