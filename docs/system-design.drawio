          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="notify" value="DB trigger inserts ingestion_notifications in job transaction&#10;Worker dispatches/retries SQS publication; PostgreSQL polling remains authoritative" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="400" y="1170" width="960" height="100" />
