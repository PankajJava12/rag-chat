        <mxCell id="chunks" value="document_chunks&#10;Version + generation + chunk_index&#10;Encrypted content + provenance&#10;Vector / model / dimensions&#10;Blind keyword vector" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1200" y="430" width="310" height="160" />
