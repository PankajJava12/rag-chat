        <mxCell id="docs" value="documents&#10;Policy association / document type&#10;Soft deletion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="820" y="160" width="280" height="110" />
