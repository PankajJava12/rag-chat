        <mxCell id="users" value="users&#10;Verified subject / role / disabled&#10;ADMIN or ADVISOR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=15;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="380" width="270" height="110" />
