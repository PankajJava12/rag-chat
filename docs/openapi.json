    "/api/v1/documents/upload-url": {
      "post": {
        "summary": "ADMIN: reserve immutable version; returns authenticated local PUT URL, not an S3 URL",
        "security": [
          {
            "bearerAuth": []
          },
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "ADMIN: reserve immutable version; returns authenticated local PUT URL, not an S3 URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "Safe error code. Common statuses: 400 validation, 401 authentication, 403 role/origin, 404 invisible resource, 409 state/version conflict, 413 size, 415 format, 429 rate limit, 503 dependency.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "policyId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "documentId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "documentType": {
                    "enum": [
                      "policy",
                      "rider",
                      "brochure",
                      "terms"
                    ],
                    "default": "policy"
                  },
                  "fileName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "mimeType": {
                    "enum": [
                      "application/pdf",
                      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
                      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                      "text/csv"
                    ]
                  },
                  "sizeBytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 26214400
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "effectiveFrom": {
                    "type": "string",
                    "format": "date"
                  },
                  "effectiveTo": {
                    "type": "string",
                    "format": "date"
                  },
                  "supersedesId": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                "required": [
                  "policyId",
                  "fileName",
                  "mimeType",
                  "sizeBytes",
                  "sha256",
                  "effectiveFrom"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
