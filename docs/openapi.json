  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "advisor_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "DocumentStatus": {
        "enum": [
          "PENDING_UPLOAD",
          "UPLOADED",
          "PROCESSING",
          "INDEXED",
          "FAILED",
          "ARCHIVED"
        ]
      },
      "Upload": {
        "type": "object",
        "properties": {
          "policyId": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "documentType": {
            "enum": [
              "policy",
              "rider",
              "brochure",
              "terms"
            ],
            "default": "policy"
          },
          "fileName": {
            "type": "string",
            "maxLength": 200
          },
          "mimeType": {
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "text/csv"
            ]
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 26214400
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date"
          },
          "effectiveTo": {
            "type": "string",
            "format": "date"
          },
          "supersedesId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "policyId",
          "fileName",
          "mimeType",
          "sizeBytes",
          "sha256",
          "effectiveFrom"
        ],
        "additionalProperties": false
      }
    }
  }
}
